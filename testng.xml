<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Full Suite" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="com.andrewvimal.framework.reporting.TestListener"/>
    </listeners>
    <test name="UI Tests">
        <packages>
            <package name="com.andrewvimal.tests.ui"/>
        </packages>
    </test>
    <test name="API Tests" parallel="none">
        <packages>
            <package name="com.andrewvimal.tests.api"/>
        </packages>
    </test>
</suite>
