<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Suite" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="com.andrewvimal.framework.reporting.TestListener"/>
    </listeners>
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.andrewvimal.tests.*"/>
        </packages>
    </test>
</suite>
